<%
  /*
    HEADER BERSAMA. Cara memakai di tiap halaman:

      include('../partials/header', { judulHalaman: 'Daftar Mitra', judul: 'HaloLaw', ikonJudul: 'telepon' })
      (dipanggil dengan tag include milik EJS di baris paling atas tiap halaman)

    Opsi (semua boleh dihilangkan):
      varian      : 'polos'  -> hanya logo di tengah (halaman login/registrasi)
                    'penuh'  -> logo kiri, judul tengah, lonceng + profil kanan
                    (bawaan: 'penuh' jika sudah login, 'polos' jika belum)
      judul       : tulisan di tengah header (contoh: 'HaloLaw', 'SearchLaw')
      ikonJudul   : ikon di samping judul: 'telepon' | 'buku' (tambah sendiri di bawah)
      judulHalaman: judul tab browser
      css         : file css tambahan, mis. '/css/konsultasi.css' (string atau array)
      navMitra    : 'pengajuan' | 'konfirmasi' | 'chat' -> menu tengah mitra (UC11)
      bodyClass   : class tambahan di <body>
  */
  var adaUser   = !!locals.user;
  var varian    = locals.varian || (adaUser ? 'penuh' : 'polos');
  var judul     = locals.judul || '';
  var ikonJudul = locals.ikonJudul || '';
  var beranda   = adaUser ? '/' + locals.user.peran : '/login';
  var daftarSukses = locals.sukses || [];
  var daftarError  = locals.error || [];
%><!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.judulHalaman ? locals.judulHalaman + ' - LawHub' : 'LawHub' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <% (locals.css ? [].concat(locals.css) : []).forEach(function (f) { %><link rel="stylesheet" href="<%= f %>">
  <% }) %>
</head>
<body class="<%= locals.bodyClass || '' %>">
<%
  var peran = adaUser ? locals.user.peran : '';
  var tampilIkon = function (ikon) {
    if (ikon === 'telepon') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
    if (ikon === 'buku') return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>';
    return '';
  };
  // menu di dalam dropdown profil, sesuai peran
  var menuProfil = peran === 'mitra'
    ? [['/mitra/profil', 'Profil Saya'],
       ['/mitra/profil/edit', 'Edit Profil'],
       ['/mitra/dokumen', 'Dokumen Legalitas'],
       ['/transaksi/keuangan', 'Keuangan & Pencairan'],
       ['/mitra/status-verifikasi', 'Status Registrasi']]
    : [];
%>
<header class="header <%= varian === 'polos' ? 'header-polos' : '' %>">
  <div class="header-isi">
    <a class="logo" href="<%= beranda %>" aria-label="LawHub - beranda">
      <img src="/img/LawHub.png" alt="LawHub">
    </a>

    <% if (varian === 'penuh') { %>
      <%# bagian tengah: tepat SATU dari menu utama, menu mitra, atau judul %>
      <% if (locals.navAktif) { %>
        <nav class="nav-utama" aria-label="Navigasi utama">
          <% var menu = (peran === 'mitra')
               ? [['beranda', '/mitra', 'Beranda'],
                  ['pengajuan', '/konsultasi/pengajuan', 'List Pengajuan'],
                  ['konfirmasi', '/konsultasi/pengajuan', 'Konfirmasi Konsultasi']]
               : [['beranda', '/masyarakat', 'Beranda'],
                  ['sesi', '/konsultasi/saya', 'Sesi Saya'],
                  ['history', '/transaksi/riwayat', 'History'],
                  ['livechat', '/masyarakat/livechat', 'Live Chat']];
             menu.forEach(function (m) { %>
            <a href="<%= m[1] %>" <%- locals.navAktif === m[0] ? 'aria-current="page"' : '' %>><%= m[2] %></a>
          <% }); %>
        </nav>
      <% } else if (locals.navMitra) { %>
        <nav class="nav-mitra" aria-label="Navigasi mitra">
          <a href="/mitra">Beranda</a>
          <a href="/konsultasi/pengajuan" <%- locals.navMitra === 'pengajuan' ? 'aria-current="page"' : '' %>>List Pengajuan</a>
          <% if (locals.navMitra === 'konfirmasi') { %><a href="#" aria-current="page">Konfirmasi Konsultasi</a><% } %>
        </nav>
      <% } else if (locals.menu) { %>
        <nav class="menu-header">
          <% locals.menu.forEach(function (m) { %><a href="<%= m.href %>"><%= m.teks %></a><% }) %>
        </nav>
      <% } else { %>
        <h1 class="judul-header"><%= judul %> <%- tampilIkon(ikonJudul) %></h1>
      <% } %>

      <%# bagian kanan: lonceng + profil %>
      <div class="header-kanan">
        <% if (adaUser) { %>
          <a class="ikon-tombol" href="#" title="Notifikasi" aria-label="Notifikasi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          </a>
          <details class="profil">
            <summary class="ikon-tombol" title="Profil" aria-label="Menu profil">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="10" r="3"/><path d="M6.17 18.5a7 7 0 0 1 11.66 0"/></svg>
            </summary>
            <div class="profil-menu">
              <strong><%= locals.user.nama %></strong>
              <small><%= locals.user.peran %></small>
              <% menuProfil.forEach(function (m) { %><a href="<%= m[0] %>"><%= m[1] %></a><% }) %>
              <a href="/logout">Keluar</a>
            </div>
          </details>
        <% } %>
      </div>
    <% } %>
  </div>
</header>

<main class="konten">
<% daftarSukses.forEach(function (p) { %><div class="alert alert-sukses"><%= p %></div><% }) %>
<% daftarError.forEach(function (p) { %><div class="alert alert-error"><%= p %></div><% }) %>