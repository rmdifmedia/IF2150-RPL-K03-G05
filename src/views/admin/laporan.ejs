<%- include('../partials/header') %>

<style>
  .admin-wrap {
    max-width: 920px;
    margin: 28px auto 56px;
    padding: 0 20px;
    color: #432c19;
  }
  .admin-wrap .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 20px;
  }
  .admin-wrap .page-title {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    color: #432c19;
  }
  .admin-wrap .filter-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .admin-wrap .filter-pill {
    text-decoration: none;
    font-size: 12.5px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 999px;
    background-color: #e9e4dc;
    color: #5b432e;
  }
  .admin-wrap .filter-pill.active {
    background-color: #432c19;
    color: #ffffff;
  }
  .admin-wrap .laporan-card {
    background-color: #ffffff;
    border-radius: 16px;
    padding: 18px 22px;
    margin-bottom: 18px;
    box-shadow: 0 2px 6px rgba(67, 44, 25, 0.05);
  }
  .admin-wrap .card-top {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 14px;
  }
  .admin-wrap .avatar-box {
    width: 68px;
    height: 68px;
    border-radius: 6px;
    background-color: #d3d5d7;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .admin-wrap .card-info {
    flex: 1;
    min-width: 0;
  }
  .admin-wrap .card-name-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }
  .admin-wrap .card-name {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: #432c19;
  }
  .admin-wrap .meta-sub {
    font-size: 12px;
    font-weight: 500;
    color: #8c7056;
  }
  .admin-wrap .card-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.45;
    color: #7c5c3e;
  }
  .admin-wrap .card-desc strong {
    color: #5c4028;
    font-weight: 600;
  }
  .admin-wrap .ulasan-quote {
    margin-top: 6px;
    font-size: 12.5px;
    color: #6b533b;
    background-color: #faf8f5;
    padding: 6px 10px;
    border-radius: 6px;
    border-left: 3px solid #d6c3a5;
  }
  .admin-wrap .card-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .admin-wrap .catatan-input {
    flex: 1;
    background-color: #f2efeb;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13.5px;
    color: #432c19;
    outline: none;
  }
  .admin-wrap .catatan-input::placeholder {
    color: #a3978b;
  }
  .admin-wrap .catatan-input:focus {
    border-color: #c8b69e;
    background-color: #f8f6f2;
  }
  .admin-wrap .btn-pill {
    border: none;
    border-radius: 999px;
    padding: 9px 24px;
    font-size: 13.5px;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
    min-width: 126px;
    text-align: center;
    transition: opacity 0.15s ease;
  }
  .admin-wrap .btn-pill:hover { opacity: 0.92; }
  .admin-wrap .btn-tolak { background-color: #169c43; }
  .admin-wrap .btn-blokir { background-color: #c81010; }
  .admin-wrap .status-selesai {
    font-size: 13px;
    font-weight: 600;
    padding: 7px 16px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .admin-wrap .status-disetujui { background-color: #fee2e2; color: #991b1b; }
  .admin-wrap .status-ditolak { background-color: #dcfce7; color: #166534; }
  .admin-wrap .empty-state {
    background: #ffffff;
    border-radius: 16px;
    padding: 36px 24px;
    text-align: center;
    color: #7c5c3e;
    font-size: 14.5px;
  }
  @media (max-width: 720px) {
    .admin-wrap .card-actions { flex-wrap: wrap; }
    .admin-wrap .catatan-input { width: 100%; flex: 1 1 100%; }
    .admin-wrap .btn-pill { flex: 1; }
  }
</style>

<div class="admin-wrap">
  <div class="header-row">
    <h1 class="page-title">List Laporan</h1>

    <div class="filter-group">
      <a href="/admin/laporan?status=menunggu" class="filter-pill <%= statusAktif === 'menunggu' ? 'active' : '' %>">Menunggu</a>
      <a href="/admin/laporan?status=disetujui" class="filter-pill <%= statusAktif === 'disetujui' ? 'active' : '' %>">Diblokir</a>
      <a href="/admin/laporan?status=ditolak" class="filter-pill <%= statusAktif === 'ditolak' ? 'active' : '' %>">Ditolak</a>
      <a href="/admin/laporan?status=semua" class="filter-pill <%= statusAktif === 'semua' ? 'active' : '' %>">Semua</a>
    </div>
  </div>

  <% if (daftarLaporan.length === 0) { %>
    <div class="empty-state">
      Tidak ada data laporan pelanggaran pada kategori ini.
    </div>
  <% } else { %>
    <% daftarLaporan.forEach((item) => { %>
      <form method="POST" class="laporan-card">
        <div class="card-top">
          <div class="avatar-box" aria-hidden="true">
            <svg width="46" height="46" viewBox="0 0 24 24" fill="#a8acb0">
              <circle cx="12" cy="8" r="4.2"/>
              <path d="M4 20c0-3.8 3.6-6.5 8-6.5s8 2.7 8 6.5"/>
            </svg>
          </div>

          <div class="card-info">
            <div class="card-name-row">
              <h2 class="card-name"><%= item.namaTerlapor %></h2>
              <span class="meta-sub">
                Terlapor: <span style="text-transform:capitalize;"><%= item.peranTerlapor %></span>
                &bull; Pelapor: <%= item.namaPelapor %>
                &bull; <%= item.tanggalLaporan %>
              </span>
            </div>

            <p class="card-desc">
              <strong><%= item.jenisPelanggaran %></strong> . <%= item.deskripsi %>
            </p>

            <% if (item.idUlasan) { %>
              <div class="ulasan-quote">
                Ulasan terlapor (#<%= item.idUlasan %>): "<%= item.teksUlasan || '-' %>"
              </div>
            <% } %>
          </div>
        </div>

        <div class="card-actions">
          <% if (item.statusLaporan === 'menunggu') { %>
            <input
              type="text"
              name="catatan"
              class="catatan-input"
              placeholder="Tulis catatan..."
            />

            <button
              type="submit"
              formaction="/admin/laporan/<%= item.idLaporan %>/tolak"
              class="btn-pill btn-tolak"
              onclick="return confirm('Tolak pemblokiran untuk akun <%= item.namaTerlapor %>?');"
            >
              Tolak Blokir
            </button>

            <button
              type="submit"
              formaction="/admin/laporan/<%= item.idLaporan %>/blokir"
              class="btn-pill btn-blokir"
              onclick="return confirm('Blokir akun <%= item.namaTerlapor %> dari seluruh akses sistem?');"
            >
              Blokir
            </button>
          <% } else { %>
            <input
              type="text"
              class="catatan-input"
              value="<%= item.catatanAdmin || 'Laporan telah selesai ditinjau.' %>"
              disabled
            />
            <span class="status-selesai status-<%= item.statusLaporan %>">
              <%= item.statusLaporan === 'disetujui' ? 'Akun Diblokir' : 'Blokir Ditolak' %>
            </span>
          <% } %>
        </div>
      </form>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>